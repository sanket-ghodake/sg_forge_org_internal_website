# ==============================================================================
# AG Dashboard - Environment Configuration Template (2026 LTS)
# Single Source of Truth for Dynamic Ingress, Docker Stacks & White-Labeling
# ==============================================================================

# Core Project & Container Identity
COMPOSE_PROJECT_NAME="ag_dashboard"
CONTAINER_PREFIX="ag"
DOCKER_NETWORK="ag_net"

# Environment Modes:
# - APP_ENV: Protects CLI operations and safeguards against accidental DB wipes (run.sh)
# - NODE_ENV: Application runtime performance, caching, and security enforcement
APP_ENV="development"
NODE_ENV="development"

# Ingress Ports (Reverse Proxy Gateway)
# Development defaults to 8080 / 8443 so Port 80 / 443 remains free for Production
HTTP_PORT="8080"
HTTPS_PORT="8443"
PROD_HTTP_PORT="80"
PROD_HTTPS_PORT="443"

# TLS / HTTPS Reverse Proxy Gateway (Optional - Air-Gapped Internal PKI or Custom CA)
# Set ENABLE_HTTPS="true" to bind Caddy to HTTPS_PORT. If TLS_CERT_PATH and TLS_KEY_PATH
# are omitted, Caddy automatically provisions an internal air-gapped local PKI ("tls internal").
# ENABLE_HTTPS="false"
# TLS_CERT_PATH="/etc/caddy/certs/cert.pem"
# TLS_KEY_PATH="/etc/caddy/certs/key.pem"

# Internal Base Ports (Used by standalone services and mapped to APP_* entries below)
LANDING_PORT="3000"
PORTAL_PORT="3001"
DEV_DASHBOARD_PORT="3002"
DEV_HUB_PORT="3003"
AUTH_PORT="3004"

# ==============================================================================
# 🧩 SINGLE-LOCATION FORGE APP & PROXY REGISTRY
# Format: APP_<ID>="<Display Name>|<Internal Port>|<Public Ingress Path>|<Category>|<Access Role>|[Upstream/Container Override]"
# Note: Changing core ports requires keeping Base Ports above in parity to prevent 502 Bad Gateway.
# ==============================================================================
APP_PORTAL="Main Workspace & Org Canvas|3001|/portal|Core Enterprise Services|Employee / Admin"
APP_DEVCENTER="Developer Dashboard|3002|/devcenter|Core Enterprise Services|Developer"
APP_GATEWAY="Developer Hub & SDK Playground|3003|/gateway|Core Enterprise Services|Developer"
APP_AUTH="Central Identity & Auth|3004|/auth|Core Enterprise Services|Public / OAuth"
APP_EXPENSES="Expense Approval Engine|8085|/apps/expenses|Isolated Polyglot Forge Micro-Apps|Finance / Manager"
APP_BILLING="Invoicing & Billing Service|8086|/apps/billing|Isolated Polyglot Forge Micro-Apps|Finance"
APP_TELEMETRY="Live Telemetry Dashboard|8087|/apps/telemetry|Isolated Polyglot Forge Micro-Apps|Public / Engineering"

# Authentication & ASVS 5.0 Zero-Trust Security
# NOTICE: In production (NODE_ENV=production), JWT_SECRET must be set to an external 32+ char key without 'dev-portable'
# Generate secure key via: openssl rand -hex 32
JWT_SECRET="dev-portable-secret-key-that-is-at-least-32-characters-long"
JWT_ACCESS_TOKEN_EXPIRY_SECONDS="900"
JWT_REFRESH_TOKEN_EXPIRY_SECONDS="604800"
SESSION_COOKIE_NAME="forge_session"

# Developer Dashboard Authentication
# In production, operator password must be >= 12 chars and cannot contain 'change-me' or 'dev-operator'
DEV_DASHBOARD_PASSWORD="dev-operator-secure-password-change-me"

# Enterprise Identity & Domain Scoping
AUTH_ORG_DOMAIN="forge.internal"
PUBLIC_DOMAIN="app.forge.internal"
SUPPORT_EMAIL="support@forge.internal"

# Canonical Data Directory Override (Optional)
# Leave empty to default to container standard mount (/app/data) or repository root (./apps/data)
FORGE_DATA_DIR=""

# Production Database Backup Engine (Optional)
# Set DB_BACKUP_DIR to custom OS path (e.g. /var/backups/sg_forge) or leave empty for ./backups/db
DB_BACKUP_DIR=""
DB_BACKUP_INTERVAL_MINUTES="60"
DB_BACKUP_RETENTION_HOURS="168"
DB_BACKUP_ENCRYPT="false"
DB_BACKUP_ENCRYPTION_KEY=""

# Application-Level Runtime Field Encryption (AES-256-GCM)
# Generate via: openssl rand -hex 32
DATA_ENCRYPTION_KEY="dev-portable-data-encryption-key-must-be-32-chars-minimum!"
BLIND_INDEX_SALT="dev-portable-blind-index-salt-32-chars-minimum!"

# Branding & Dynamic White-Labeling (Public)
NEXT_PUBLIC_BRAND_NAME="AG Dashboard"
NEXT_PUBLIC_ORG_NAME="AG Dashboard"
NEXT_PUBLIC_BRAND_SHORT="AG"
NEXT_PUBLIC_BRAND_TAGLINE="Modular Corporate Portal & Sandboxing Engine"
NEXT_PUBLIC_BRAND_LOGO_URL="/brand/logo.png"
NEXT_PUBLIC_BRAND_FAVICON_URL="/favicon.ico"
