# ==============================================================================
# SG Forge - Monolith OS Environment Template
# ==============================================================================

# Core Orchestration
COMPOSE_PROJECT_NAME="sgforge"
PROJECT_NAME="sgforge"
APP_ENV="development"
NODE_ENV="development"
PORTAL_URL="http://localhost:3001"
PORT="3001"
DEV_DASHBOARD_PORT="3002"
DEV_PROXY_PORT="3003"
HTTP_PORT="80"
HTTPS_PORT="443"

# Database & Connection Strings
DATABASE_URL="postgres://lifeos:change_me_db_password@localhost:5433/org_db"
DATABASE_READONLY_URL="postgres://lifeos:change_me_db_password@localhost:5433/org_db"
POSTGRES_DB="org_db"
POSTGRES_USER="lifeos"
POSTGRES_PASSWORD="change_me_db_password"

# Authentication & ASVS 5.0 Zero-Trust Security
JWT_SECRET="dev-portable-secret-key-that-is-at-least-32-characters-long"
JWT_EXPIRY_SECONDS="86400"
SESSION_COOKIE_NAME="__Host-sg-session"
DEV_DASHBOARD_PASSWORD="password123"

# Branding & Dynamic White-Labeling (Public)
NEXT_PUBLIC_BRAND_NAME="SG Forge"
NEXT_PUBLIC_BRAND_SHORT="SG"
NEXT_PUBLIC_BRAND_TAGLINE="Modular Corporate Portal Engine"
NEXT_PUBLIC_BRAND_LOGO_URL="/brand/logo.svg"
NEXT_PUBLIC_BRAND_FAVICON_URL="/favicon.ico"

# Branding & Corporate Identity (Backend & Server)
BRAND_NAME="SG Forge"
BRAND_SHORT="SG"
COMPANY_NAME="SG Forge Corporation"
SUPPORT_EMAIL="support@sgforge.internal"

# Polling & Dev Watches
WATCHPACK_POLLING="false"
CHOKIDAR_USEPOLLING="0"
