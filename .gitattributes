# ==============================================================================
# Git Attributes Configuration (Google & Meta Enterprise Standard)
# Auto-normalization of line endings, binary identification, Linguist & export controls
# ==============================================================================

# 1. Default Behavior
* text=auto

# 2. Linux / Unix Shell Scripts & Entrypoints (Strict LF)
*.sh text eol=lf
*.bash text eol=lf
*.zsh text eol=lf
*.fish text eol=lf
entrypoint.sh text eol=lf
run.sh text eol=lf
Dockerfile* text eol=lf

# 3. Windows Shell & Batch Scripts (Strict CRLF)
*.bat text eol=crlf
*.cmd text eol=crlf
