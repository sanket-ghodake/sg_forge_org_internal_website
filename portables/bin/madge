#!/usr/bin/env bash
# ==============================================================================
# Standalone Portable Wrapper for Madge (Circular Dependency Auditor)
# Zero Host Modification - Uses Repo-Local Portable Toolchain
# ==============================================================================
set -e

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
REPO_ROOT="$(cd "$SCRIPT_DIR/../.." && pwd)"
BUN="$REPO_ROOT/portables/bun/bin/bun"
LOCAL_BIN="$REPO_ROOT/node_modules/.bin/madge"

if [ -f "$LOCAL_BIN" ] && [ -f "$BUN" ]; then
    exec "$BUN" run "$LOCAL_BIN" --circular --extensions ts,tsx "$@"
elif command -v madge >/dev/null 2>&1; then
    exec madge --circular --extensions ts,tsx "$@"
else
    echo "❌ [madge] Local binary not found at $LOCAL_BIN. Run './run.sh setup' to install." >&2
    exit 1
fi
