#!/usr/bin/env bash
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
WORKSPACE_ROOT="$(cd "$SCRIPT_DIR/../.." && pwd)"
VENV_LIZARD="$WORKSPACE_ROOT/.venv/bin/lizard"
if [ -x "$VENV_LIZARD" ]; then
  exec "$VENV_LIZARD" "$@"
else
  PYTHON="$WORKSPACE_ROOT/.venv/bin/python3"
  if [ -x "$PYTHON" ]; then
    exec "$PYTHON" -m lizard "$@"
  elif command -v lizard &>/dev/null; then
    exec lizard "$@"
  else
    BUN="$WORKSPACE_ROOT/portables/bun/bin/bun"
    if [ -x "$BUN" ]; then
      exec "$BUN" run "$WORKSPACE_ROOT/scripts/ast-complexity.ts" "$@"
    else
      exec bun "$WORKSPACE_ROOT/scripts/ast-complexity.ts" "$@"
    fi
  fi
fi
