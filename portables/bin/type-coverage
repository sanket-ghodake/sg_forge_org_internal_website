#!/usr/bin/env bash
# ==============================================================================
# Standalone Portable Wrapper for Type Coverage Auditor (TypeScript Strictness)
# Zero Host Modification - Uses Repo-Local Portable Toolchain
# ==============================================================================
set -e

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
REPO_ROOT="$(cd "$SCRIPT_DIR/../.." && pwd)"
BUN="$REPO_ROOT/portables/bun/bin/bun"
LOCAL_BIN="$REPO_ROOT/node_modules/.bin/type-coverage"

if [ -f "$LOCAL_BIN" ] && [ -f "$BUN" ]; then
    exec "$BUN" run "$LOCAL_BIN" --at-least 90 "$@"
elif command -v type-coverage >/dev/null 2>&1; then
    exec type-coverage --at-least 90 "$@"
else
    echo "❌ [type-coverage] Local binary not found at $LOCAL_BIN. Run './run.sh setup' to install." >&2
    exit 1
fi
