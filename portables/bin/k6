#!/usr/bin/env bash
# ==============================================================================
# Standalone Portable Wrapper for k6 (Modern Load Testing Engine)
# Zero Host Modification - Standalone Binary / Docker / Native Fallback
# ==============================================================================
set -e

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
REPO_ROOT="$(cd "$SCRIPT_DIR/../.." && pwd)"
LOCAL_BIN="$REPO_ROOT/portables/k6/k6"

if [ -x "$LOCAL_BIN" ]; then
    exec "$LOCAL_BIN" "$@"
elif command -v k6 >/dev/null 2>&1; then
    exec k6 "$@"
elif command -v docker >/dev/null 2>&1 && docker info >/dev/null 2>&1; then
    exec docker run --rm -i --net=host grafana/k6:latest "$@"
else
    # Zero-dependency portable fallback: Uses existing autocannon runner
    echo "⚡ [k6 Portable] Running performance benchmark via autocannon fallback..."
    "$REPO_ROOT/portables/bin/autocannon" "$@"
fi
